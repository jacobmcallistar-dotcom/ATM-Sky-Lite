		{
			dependencies: ["57D0000000000001"]
			description: [
				"A &eDrawer&r holds one item type and shows it on its face - your cobble, your dust, your ore chunks, readable from across the room."
				""
				"Build a wall of them next to the sieves. Bulk stackables never touch a chest again."
			]
			icon: "storagedrawers:oak_full_drawers_1"
