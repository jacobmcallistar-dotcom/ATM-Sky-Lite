					type: "item"
				}
			]
			title: "&3Better Compressors"
			x: -3.0d
			y: -3.0d
		}
		{
			description: [
				"Standard tubes fail above 5 bar. Advanced tubes hold considerably more."
				""
				"&7Every high-tier machine wants pressure the basic tube cannot legally carry, so this is not optional for long.&r"
				""
				"&c&lMixing tube tiers means the weakest link sets your real ceiling&r - one basic tube left in an advanced run will burst and vent the network."
				""
				"&8Check your runs after any rebuild. This is the most common cause of bases that keep exploding.&r"
			]
			icon: "pneumaticcraft:advanced_pressure_tube"
			id: "2CA2FCA3486332F8"
