		{
			description: [
				"&c&lDraconic Evolution.&r"
				""
				"Endgame tech: tools, armor and reactors that make everything before this look quaint. Runs on &6Brandon's Core&r and &6CodeChicken Lib&r underneath - both included."
			]
			icon: "draconicevolution:draconium_ingot"
