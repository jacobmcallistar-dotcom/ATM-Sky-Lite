	quest_links: [ ]
	quests: [
		{
			description: [
				"&2&lCompact Machines.&r"
				""
				"Miniaturized pocket-dimension rooms, placed inside a single block. No island is big enough for every factory - so build the factory somewhere else entirely."
			]
			icon: "compactmachines:machine_normal"
			id: "598E4E0BE319AF70"
			rewards: [{
				id: "4AD918C7024E9D50"
				type: "xp"
				xp: 30
			}]
			shape: "hexagon"
			size: 1.5d
			subtitle: "&7A room in a block"
			tasks: [{
				id: "01B80D8EAE3EADFE"
				item: "compactmachines:machine_normal"
				type: "item"
			}]
			title: "&bCompact Machines"
			x: 0.0d
			y: -1.5d
		}
		{
			description: [
				"Item, fluid and energy &etunnels&r punch a connection through a machine wall - so the pocket room outside can still feed power and resources in, and pull products back out."
				""
				"&e&lWithout tunnels a Compact Machine is a sealed box.&r The room inside is a genuinely separate space - nothing crosses the wall on its own. A tunnel creates one matched pair of ports: one on the inside wall, one on the outer block face."
				""
				"&e&lHow to place one:&r hold the tunnel item and right-click the &linside&r wall. It appears on the corresponding outside face, colour-coded so you can tell pairs apart. Use the same colour dye on both ends when you have several."
				""
				"&e&lTunnel types:&r"
				"&7- &fItem&7 - in or out, set the direction with a wrench"
				"&7- &fFluid&7 - same, for tanks and pipes"
				"&7- &fEnergy&7 - FE across the wall"
				""
				"&e&lWhy bother at all:&r a Compact Machine is one block on your island containing an entire room. On a floating platform where space and chunk-loading both cost you, putting your whole ore-processing line inside one block is a real win."
				""
				"&8The room only ticks if the block holding it is loaded. Force-load the chunk the machine sits in, not some imaginary chunk inside."
			]
			icon: "compactmachines:tunnel_wall"
			id: "660F0AFCCBF74D89"
			rewards: [{
				id: "4B4F733A9785F866"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Punch a connection through"
			tasks: [{
				id: "51F38DADD34E2655"
				item: "compactmachines:tunnel_wall"
				type: "item"
			}]
			title: "&bTunnels"
			x: -2.0d
			y: -1.5d
		}
		{
			description: [
				"The &ePersonal Shrinking Device&r is how you get inside a Compact Machine."
				""
				"&e&lThe machine is a room in its own dimension.&r From outside it is one block; inside it is anywhere from 3x3 to 16x16. Right-click with this to enter, and use the exit to leave."
				""
				"&7Hide an entire processing wing inside a single block. The chunk it lives in still has to be loaded for it to run.&r"
			]
			icon: "compactmachines:personal_shrinking_device"
			id: "07736704666D9DC2"
			rewards: [{
				id: "1056294EC694EDE5"
				type: "xp_levels"
				xp_levels: 3
			}]
			subtitle: "&7Walk right in"
			tasks: [{
				id: "0359D3CB537D592A"
				item: "compactmachines:personal_shrinking_device"
				type: "item"
			}]
			title: "&bPersonal Shrinking Device"
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["598E4E0BE319AF70"]
			description: [
				"Compact Machines come in six sizes - &eTiny&r, &eSmall&r, &eNormal&r, &eLarge&r, &eGiant&r and &eMaximum&r - from a 3x3 room up to 15x15."
				""
				"&e&lThe block is always one block.&r Only the interior grows, so a Maximum machine is still a single block on your island holding a 15x15x15 room."
				""
				"&7On a floating platform where space and chunk-loading both cost you, that is the entire point. An ore-processing line that would sprawl across your island fits in one block.&r"
				""
				"&8Start with a Normal. Upgrading later means rebuilding the interior, so leave yourself room."
			]
			icon: "compactmachines:machine_normal"
			id: "1D2C61639894A583"
			rewards: [{
				id: "1672CE6660F5E872"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Tiny to Maximum"
			tasks: [{
				id: "23DDBC83BCB93627"
				item: "compactmachines:machine_tiny"
				type: "item"
			}]
			title: "&bMachine Sizes"
			x: -4.0d
			y: 1.5d
		}
		{
			description: [
				"Tunnels are the only thing that crosses a machine wall. Place them on the &linside&r wall and a matching port appears outside."
				""
				"&e&lThree kinds:&r item, fluid and energy. Each is directional - set it with a wrench to push in or pull out."
				""
				"&c&lColour-code them.&r With more than two tunnels it becomes very hard to tell which outside face belongs to which inside wall. Dye them as you place them."
				""
				"&7You can have many tunnels per machine, so a single Compact Machine can take power in, materials in, and push three different outputs to three different destinations.&r"
			]
			icon: "compactmachines:tunnel"
			id: "3FDACB0764D6A0FF"
			rewards: [{
				id: "56AE56888A210407"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Item, fluid, energy"
			tasks: [{
				id: "1F08CE73396987DD"
				item: "compactmachines:tunnel"
				type: "item"
			}]
			title: "&bTunnel Types"
			x: -2.0d
			y: 1.5d
		}
		{
			description: [
				"The &ePersonal Shrinking Device&r lets you enter any Compact Machine you own by right-clicking it, and leave with a command or the device again."
				""
				"&7Without it you would have to build a door structure. With it, machines are just rooms you step into.&r"
				""
				"&8Keep one in your hotbar permanently once you start using Compact Machines seriously."
			]
			icon: "compactmachines:personal_shrinking_device"
			id: "7F78134F3F83264C"
			rewards: [{
				id: "3351BF7017520155"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Walk in and out"
			tasks: [{
				id: "2405A6FAA73DE0A6"
				item: "compactmachines:personal_shrinking_device"
				type: "item"
			}]
			title: "&bPersonal Shrinking Device"
			x: 0.0d
			y: 1.5d
		}
		{
			description: [
				"A Compact Machine's interior only ticks while the block holding it is loaded."
				""
				"&c&lForce-load the chunk the MACHINE sits in&r, not some imaginary chunk inside it. A machine in an unloaded chunk is a room where nothing happens."
				""
				"&e&lThis is also the mod's biggest performance advantage.&r One loaded chunk holding a 15x15 factory is far cheaper than the same factory spread across four chunks."
				""
				"&7Combined with the standing rule on this server about not slowing things down, Compact Machines are the tidiest way to run a lot of machinery.&r"
			]
			icon: "compactmachines:wall"
			id: "6FAC5A51117932D7"
			rewards: [{
				id: "71538E0B704DAB6B"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Ticking inside the block"
			tasks: [{
				id: "7D03B138BAE8EA82"
