			shape: "gear"
			subtitle: "&7Send it out. It comes back."
			tasks: [
				{
					id: "31FF6175A761CF69"
					item: "pneumaticcraft:drone"
					type: "item"
				}
				{
					id: "17D6C541FE803C20"
