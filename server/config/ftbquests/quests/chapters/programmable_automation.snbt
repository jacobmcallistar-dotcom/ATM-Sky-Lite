				type: "item"
			}]
			title: "&bSFM Cable"
			x: -6.0d
			y: -3.0d
		}
		{
			dependencies: ["47A7B0BFB116D2EB"]
			description: [
				"Two finishing pieces."
				""
				"The &eLabel Gun&r (crafted, then used on blocks) tags inventories with names your program refers to - &7chest&r, &7furnace&r, &7output&r. Rename the label and every program using it follows."
				""
				"The &eNetwork Tool&r shows you what the Manager can currently see, which is the fastest way to find the one cable you forgot to connect."
			]
			icon: "sfm:network_tool"
			id: "3300CBEB9EA7135B"
			rewards: [
				{
