		}
		{
			dependencies: ["07EA52F629E3F2E5"]
			description: [
				"The &eCrafting Interface&r lets the logic network request crafts, not just move finished goods."
				""
				"Point it at a crafting setup, tell it what recipes that setup can make, and any part of your network can now ask for those items on demand - the same idea as an AE2 pattern provider, driven by your own conditions instead."
				""
				"This is the point where Integrated Dynamics stops being a curiosity and starts replacing infrastructure."
			]
			icon: "integratedcrafting:part_interface_crafting"
			id: "159FB53B985A6BBD"
