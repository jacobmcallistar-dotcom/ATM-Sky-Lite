		{
			dependencies: ["025F9F5BB50F3C61"]
			description: [
				"No air in space. An Oxygen Distributor floods a sealed room with breathable air; an Oxygen Loader fills your tanks."
				""
				"A Water Pump feeds them. This is your life support - do not skip it."
			]
			icon: "ad_astra:oxygen_distributor"
			id: "15008CDD6EC8DA95"
			rewards: [{
				id: "7C51C336ACD0DF08"
