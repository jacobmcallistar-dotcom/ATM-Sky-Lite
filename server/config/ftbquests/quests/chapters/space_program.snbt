			title: "&9Calorite & Tier 4"
			x: 10.0d
			y: -1.5d
		}
		{
			dependencies: ["13FF1430C16D9379"]
			description: [
				"&bGlacio&r - a frozen exoplanet beyond the solar system, and the last destination Ad Astra has."
				""
				"&e&lEtrium&r waits in the ice, and unlike the inner worlds Glacio has real terrain, real caves and real vegetation. It is the only planet that feels like somewhere you could live."
				""
				"&7Cold rather than lethal, which after Venus and Mercury is close to a holiday.&r"
			]
			icon: "ad_astra:glacio_stone"
			id: "3811F52536EF179D"
			rewards: [
				{
					count: 4
					id: "79710CE0E3FE3A90"
					item: "ad_astra:etrium_ingot"
					type: "item"
