			}]
			title: "&eWeighted Ejector"
			x: -6.0d
			y: 4.5d
		}
		{
			dependencies: ["7F00000000000008"]
			description: [
				"&eItem Vaults&r are large-capacity storage blocks that &lmerge with each other&r into a single bigger inventory."
				""
				"&e&lPlace them in a rectangle and they become one container.&r A 3x3x3 of vaults is one enormous inventory with one access point - far tidier than a wall of chests, and much easier to pipe into."
				""
				"&7They accept funnels, chutes and belts on any face, so they slot straight into a Create line without adapters.&r"
				""
				"&8Good intermediate storage before you have AE2. Not sorted, but enormous and cheap."
			]
			icon: "create:item_vault"
			id: "7F0000000000000A"
			rewards: [{
