		{
			dependencies: ["7F00000000000014"]
			description: [
				"A &eMechanical Arm&r picks items from up to twelve inputs and distributes them to up to twelve outputs, with filters on each."
				""
				"&e&lIt replaces an entire pipe network with one block.&r Wrench the arm, then click each source and each destination to program it. It remembers the order."
				""
				"&7Perfect for feeding a bank of Mechanical Crafters, or splitting a belt's output between several machines by filter.&r"
				""
				"&8It is slow compared to pipes but takes almost no space and needs no routing. For a crafting array it is usually the right answer."
			]
			icon: "create:mechanical_arm"
			id: "7F00000000000015"
			rewards: [{
				id: "7F01000000000015"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Sorting without pipes"
