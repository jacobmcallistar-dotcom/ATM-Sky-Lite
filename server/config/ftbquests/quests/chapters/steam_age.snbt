		{
			dependencies: ["7F00000000000014"]
			description: [
				"A &eRedstone Link&r transmits a redstone signal wirelessly between two points; a &eStockpile Switch&r emits one based on how full a container is."
				""
				"&e&lTogether they are automation's feedback loop.&r Stockpile Switch on your output chest, Redstone Link back to the machine, and production stops when you have enough and restarts when you spend it."
				""
				"&7Links are paired by putting the same two items in both ends' frequency slots - any two items, so you have effectively unlimited channels.&r"
				""
				"&8This is how you stop a Create farm filling every chest you own while you are away."
			]
			icon: "create:redstone_link"
			id: "7F00000000000016"
			rewards: [{
				id: "7F01000000000016"
				type: "xp"
				xp: 30
			}]
