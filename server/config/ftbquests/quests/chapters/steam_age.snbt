				}
			]
			title: "&eRedstone Link & Stockpile Switch"
			x: 4.0d
			y: -1.5d
		}
		{
			dependencies: ["7F00000000000016"]
			description: [
				"A &eDisplay Link&r reads information from a block and writes it to a &eDisplay Board&r - item counts, fluid levels, stress, time, kills."
				""
				"&e&lThis is Create's monitoring layer&r, and it needs no computer. Point a link at a tank and it prints the level; point it at a Stockpile Switch and it prints the percentage."
				""
				"&7Boards tile into larger screens, so a wall of them becomes a factory dashboard.&r"
				""
				"&8Cosmetic in the strictest sense, genuinely useful in practice - a base you can read at a glance is a base you notice problems in."
			]
			icon: "create:display_link"
