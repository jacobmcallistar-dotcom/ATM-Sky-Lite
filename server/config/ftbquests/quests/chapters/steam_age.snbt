			y: -4.5d
		}
		{
			dependencies: ["7F0000000000000B"]
			description: [
				"A &eSpout&r pours fluid onto an item beneath it; an &eItem Drain&r pulls fluid out of one passing over it."
				""
				"&e&lTogether they are Create's fluid-item interface.&r Filling bottles, charging tools, applying fluids in a recipe - all of it passes through these two blocks."
				""
				"&7The Item Drain is the fastest way to empty a stack of buckets or fluid containers - just belt them across it.&r"
				""
				"&e&lThe Spout is required for several recipes in this pack&r, so build one even if you have no fluid plans."
			]
			icon: "create:spout"
			id: "7F0000000000000D"
			rewards: [{
				id: "7F0100000000000D"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Fluids onto items, and off"
