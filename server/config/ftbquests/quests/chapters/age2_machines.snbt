		{
			dependencies: ["210200000000000B"]
			description: [
				"An &eInscriber&r stamps silicon and quartz into processors. Normally you would loot the four Inscriber Presses from a meteor - but none fall in the void, so building the Inscriber earns you all four."
				""
				"&cIts frame is held together by an Advanced Control Circuit&r - check JEI. &bBuild it and the full Applied Energistics branch opens in Act II.&r"
			]
			icon: "ae2:inscriber"
			id: "210200000000000C"
