			x: -2.0d
			y: 0.0d
		}
		{
			description: ["A &ePower Cell&r stores RF at massive scale for a single block, and the &eBlazing Generator&r burns blaze rods to fill it - RFTools' own power line, independent of Mekanism."]
			icon: "rftoolspower:cell1"
