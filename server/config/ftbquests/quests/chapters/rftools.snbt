		{
			description: [
				"&6&lRFTools.&r"
				""
				"The full suite: Utility, Builder, Power, Dimensions, Storage and Control - teleportation, screens, storage scanners, and buildable custom dimensions. All riding on the shared &6McJtyLib&r underneath."
			]
			icon: "rftoolsbase:machine_infuser"
