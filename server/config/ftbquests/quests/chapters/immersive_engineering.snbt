	quests: [
		{
			description: [
				"&eImmersive Engineering&r starts with a hammer and never really stops being physical."
				""
				"The &eEngineer's Hammer&r builds and configures everything in the mod - it rotates blocks, forms multiblocks and connects wires. You will hold it constantly."
				""
				"&7Nothing in IE is a single block that does a job. Everything worth having is a structure you assemble and then walk into."
			]
			icon: {
				Count: 1
				id: "immersiveengineering:hammer"
				tag: {
					Damage: 0
				}
			}
			id: "7E20000000000009"
			rewards: [{
