		}
		{
			dependencies: ["0BEE000000000002"]
			description: [
				"The &eAdvanced Beehive&r is the real workhorse - it holds a bee, feeds from nearby flowers, and pipes comb out automatically."
				""
				"Upgrade slots let you speed it up. This is where the branch stops being a curiosity and starts being a factory."
			]
			icon: "productivebees:advanced_oak_beehive"
			id: "0BEE000000000003"
			rewards: [{
