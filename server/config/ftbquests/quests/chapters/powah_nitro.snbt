		{
			dependencies: ["7B0000000000000F"]
			description: [
				"A &ePhotoelectric Pane&r is a flat, thin solar generator you can build into a roof or wall rather than placing as a machine."
				""
				"&e&lIt produces less than a proper solar panel&r, but it tiles, it looks like part of the building, and it costs almost nothing."
				""
				"&7On a floating island where your whole roof is exposed sky, a field of these is a surprisingly reasonable trickle supply for lighting and low-draw machines.&r"
			]
			icon: "powah:photoelectric_pane"
			id: "7B00000000000010"
