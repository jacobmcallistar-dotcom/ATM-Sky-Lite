		}
		{
			description: [
				"The &eEnchanting Apparatus&r sits on an &eArcane Core&r and is ringed by &eArcane Pedestals&r. Reagent in the middle, ingredients on the pedestals, Source supplied."
				""
				"&e&lThis is where the good items are made&r - spell books beyond the novice tier, magical armour, wands, and the charms that summon familiars."
				""
				"&7Right-click the apparatus to run it once everything is placed. It tells you if a pedestal is missing something.&r"
			]
			icon: "ars_nouveau:enchanting_apparatus"
