			]
			title: "&dFamiliars"
			x: 2.0d
			y: 3.0d
		}
		{
			description: [
				"A &eRitual Brazier&r performs area effects: growth, weather, teleportation, mob transformation, restoring a wither skeleton's soul."
				""
				"&e&lRituals worth knowing here:&r &7Overgrowth&r (mass crop growth), &7Warp&r (long-range teleport to a set point), &7Restoration&r (repairs gear from Source), and &7Wilden Summoning&r."
				""
				"&7Each ritual is a tablet placed in the brazier, plus Source, plus sometimes items on nearby pedestals.&r"
			]
			icon: "ars_nouveau:ritual_brazier"
			id: "42A6E1A512045699"
			rewards: [{
				id: "12018C54200142D8"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Big effects, one brazier"
			tasks: [{
				id: "3EF10D4BAC4EBDED"
				item: "ars_nouveau:ritual_brazier"
				type: "item"
			}]
			title: "&dRituals"
			x: -2.0d
			y: 4.5d
		}
		{
			description: [
				"&eSpell Parchment&r stores a spell; &eenchanters' gear&r casts spells on hit, on step or automatically."
				""
				"&e&lThe Enchanter's Sword casts a bound spell on every hit&r, and the armour set reduces spell cost and regenerates mana faster. A well-built set makes your custom spells genuinely competitive with Draconic gear."
				""
				"&7The &fDominion Wand&r links blocks together - a Drygmy to its chest, a spell turret to its target, a source relay to its jar. Most Ars automation needs it.&r"
			]
			icon: "ars_nouveau:spell_parchment"
			id: "394CB14D0BB9DDF5"
			rewards: [{
				id: "5DF831336930DDEA"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Wear your spells"
			tasks: [
				{
					id: "6AEA5B7D5629004C"
					item: "ars_nouveau:spell_parchment"
					type: "item"
				}
				{
					id: "3E9A4F31DCF7063D"
					item: "ars_nouveau:dominion_wand"
					type: "item"
				}
			]
			title: "&dSpell Gear"
			x: 0.0d
			y: 4.5d
		}
		{
			description: [
				"A &eSpell Turret&r casts a bound spell on a redstone pulse; &eSource Relays&r move Source between jars across distance."
				""
				"&e&lTurrets turn a spell into a machine.&r A Projectile-Break-AOE turret pointed at a cobble generator is a mining rig. A Touch-Grow turret over a farm is a growth accelerator. A Harm turret is a mob grinder."
				""
				"&7This is where Ars stops being a magic mod and becomes a genuinely competitive automation mod - your spells are the machines.&r"
				""
				"&8Relays let you generate Source in one place and consume it in another, which is how a big Ars base is laid out."
			]
			icon: "ars_nouveau:spell_turret"
			id: "126B7D588553B629"
			rewards: [{
				id: "1927E77238864683"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Automation with spells"
			tasks: [
				{
					id: "1540101763F9C84A"
					item: "ars_nouveau:spell_turret"
					type: "item"
				}
				{
					id: "464020E602804DDF"
					item: "ars_nouveau:relay"
					type: "item"
				}
			]
			title: "&dSpell Turrets & Relays"
			x: 2.0d
			y: 4.5d
		}
		{
			description: [
				"&d&lYou designed your own tools.&r"
				""
				"Every other mod in this pack hands you a machine that does one thing. Ars gives you glyphs and lets you decide what the machine is - a mining wand, a farm turret, a healing aura, a creature that collects drops without killing anything."
				""
				"&7Nothing here is required to finish the pack. It is the most creative branch in it.&r"
			]
			icon: "ars_nouveau:novice_spell_book"
			id: "33D6D5CE6C9560B1"
