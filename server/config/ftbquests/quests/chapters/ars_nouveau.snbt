	quests: [
		{
			description: [
				"&d&lArs Nouveau.&r"
				""
				"This pack's first magic mod. Craft a Spellbook, weave glyphs together, cast what you make. Runs on your existing Curios slots."
			]
			icon: "ars_nouveau:apprentice_spell_book"
			id: "1BD3F090A3FA8B3C"
