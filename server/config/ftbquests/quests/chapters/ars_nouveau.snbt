		{
			description: ["&eMagebloom&r is Ars Nouveau's signature crop - a flax-like plant you grow, harvest and spin into fiber for robes, ropes and books."]
			icon: "ars_nouveau:magebloom_crop"
			id: "572C58F284A0C55F"
			rewards: [{
