			title: "&5Seal of Circuits"
			x: -6.0d
			y: -1.5d
		}
		{
			dependencies: ["5E50000000000001"]
			description: [
				"&bEight processors&r - Engineering, Calculation and Logic - around a &bSingularity&r."
				""
				"All three processor types means the entire Inscriber line has to be running. The Singularity at the centre needs a Matter Condenser and a great deal of matter fed into it."
				""
				"&7Chapter: &fApplied Energistics&7, Act II.&r"
			]
