		{
			dependencies: ["721D4965AD3FB2EE"]
			description: [
				"Two upgrades worth the detour."
				""
				"The &eConnector Upgrade&r raises how much a single connector moves per tick - fit these on ore-processing feeds before you blame XNet for being slow."
				""
				"The &eWireless Router&r links two separate XNet networks with no cable between them. Base to island, island to nether outpost - the channels simply continue."
			]
			icon: "xnet:wireless_router"
			id: "3D806EF240D67C03"
