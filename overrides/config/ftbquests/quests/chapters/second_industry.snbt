				type: "item"
			}]
			title: "&bThermal Innovation"
			x: -5.0d
			y: 4.0d
		}
		{
			description: [
				"&aThermal Locomotion&r adds the cart and rail content to the Thermal line - energy and fluid minecarts, crossover rails, and the various TNT carts."
				""
				"&7Optional. If you are running Create trains you will not need it; it is here because the Thermal series is now complete.&r"
			]
			icon: "thermal:energy_minecart"
			id: "11D39FDCC9CADCCC"
