			title: "&6The Pulverizer"
			x: -6.0d
			y: -3.0d
		}
		{
			dependencies: ["7E20000000000003"]
			description: [
				"The &eInduction Smelter&r takes two inputs and fuses them - ore plus sand for extra yield, or two dusts into an alloy."
				""
				"It is Thermal's answer to Mekanism's infuser and EnderIO's alloy smelter, and it will happily process the ores and dusts those mods produce. Nothing here is walled off; the pack's ore chains all speak to each other."
			]
			icon: "thermal:machine_smelter"
			id: "7E20000000000004"
			rewards: [{
				id: "7E20000000000105"
				type: "xp"
				xp: 40
			}]
			subtitle: "&7Two in, one better thing out"
			tasks: [{
				id: "7E20000000000204"
				item: "thermal:machine_smelter"
				type: "item"
			}]
			title: "&6The Induction Smelter"
			x: -4.0d
			y: -3.0d
		}
		{
			dependencies: ["7E20000000000004"]
			description: [
				"The &eCentrifugal Separator&r pulls mixed inputs apart into their components - the cleanup step at the end of a processing line."
				""
				"Feed it slag, dusts, mob drops or the odd by-products the rest of your machines spit out, and it sorts them into something usable instead of something you throw away."
			]
			icon: "thermal:machine_centrifuge"
