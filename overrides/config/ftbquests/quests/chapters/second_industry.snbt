			title: "&bDucts"
			x: -6.0d
			y: -1.5d
		}
		{
			dependencies: ["7E20000000000006"]
			description: [
				"This is the part people miss, and it is the best thing about Thermal Dynamics."
				""
				"A &eServo&r clips onto the end of a duct where it meets an inventory and makes it &lextract&r. A &eFilter&r clips on and decides what may pass. No separate filter item, no upgrade tier to unlock - the filtering is built into the duct itself."
				""
				"Two attachments turn a dumb pipe into a sorting system."
			]
			icon: "thermal:servo_attachment"
			id: "7E20000000000007"
			rewards: [
