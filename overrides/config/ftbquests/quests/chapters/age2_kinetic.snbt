		{
			dependencies: ["44EA000000000001"]
			description: [
				"&eAndesite Alloy&r is the Kinetic Age's iron. Sieve gravel with a flint mesh for &eandesite pebbles&r, craft them into andesite, and alloy it with iron or zinc nuggets."
				""
				"Every shaft, casing and cogwheel starts here. Make a pile."
			]
			icon: "create:andesite_alloy"
