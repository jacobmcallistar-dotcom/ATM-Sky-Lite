	quests: [
		{
			dependencies: ["2101000000000011"]
			description: [
				"&e&lAge II · The Kinetic Age.&r"
				""
				"Before electricity, there was &orotation&r. Create turns your island into a machine of shafts, cogs and water wheels - presses that stamp sheets, fans that wash gravel into treasure, wheels that crush stone to dust."
				""
				"Everything here runs on torque you build with your own hands. Master it: &cthe Metallurgic Infuser - and all of Mekanism behind it - is built around a Precision Mechanism only this Age can make.&r"
			]
			icon: "create:water_wheel"
			id: "44EA000000000001"
			rewards: [{
