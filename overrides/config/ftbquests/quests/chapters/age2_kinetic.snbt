					item: "create:cogwheel"
					type: "item"
				}
			]
			title: "&eShafts & Cogs"
			x: -12.0d
			y: 0.0d
		}
		{
			dependencies: ["44EA000000000003"]
			description: [
				"A &eWater Wheel&r in flowing water makes free, forever torque. Your cobble generator's water was already flowing - now it works a double shift."
				""
				"More wheels, more stress capacity. The Large Water Wheel does the same job with more style."
			]
			icon: "create:water_wheel"
			id: "44EA000000000004"
			rewards: [{
