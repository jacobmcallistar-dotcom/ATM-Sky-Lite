			y: 0.0d
		}
		{
			dependencies: ["1FA9577AA6C0D787"]
			description: ["Build a Charger and charge Certus Quartz into Charged Certus - the spark for Fluix."]
			icon: "ae2:charged_certus_quartz_crystal"
