	quests: [
		{
			dependencies: ["210200000000000C"]
			description: [
				"&bApplied Energistics 2&r replaces chests with a digital storage network - and eventually an autocrafting supercomputer that builds anything on demand."
				""
				"You have Certus Quartz. Now grow it, process it, and build a network worthy of the endgame."
				""
				"&7Autocrafting is gated behind processors and a controller. Earn it.&r"
			]
			icon: "ae2:controller"
			id: "1FA9577AA6C0D787"
			rewards: [
				{
					id: "45914E456B4DA503"
