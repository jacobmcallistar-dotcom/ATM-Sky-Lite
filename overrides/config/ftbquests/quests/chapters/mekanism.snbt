					xp: 50
				}
				{
					id: "03BB7531572FAFA6"
					type: "random"
				}
			]
			shape: "hexagon"
			size: 1.5d
			subtitle: "The industrial backbone"
			tasks: [{
				id: "1F8D57A48E28B9CF"
				title: "Begin Mekanism"
				type: "checkmark"
			}]
			title: "&9The Mekanism Way"
			x: -9.0d
			y: 0.0d
		}
		{
			dependencies: ["6C0C75598D65CE7D"]
			description: [
				"Machines need power. A Basic Energy Cube stores it and acts as a battery/adapter between generators and machines."
				""
				"Feed it from your Powah or Mekanism generators."
			]
			icon: "mekanism:basic_energy_cube"
			id: "19236F17F30F94C7"
			rewards: [{
				id: "4BC9362F1B95B08A"
				type: "xp"
				xp: 20
			}]
			subtitle: "&7Energy Cubes buffer the spikes"
			tasks: [{
				id: "1058026C0E645742"
				item: "mekanism:basic_energy_cube"
				type: "item"
			}]
			title: "Store Some Power"
			x: -7.0d
			y: 2.5d
		}
		{
			dependencies: [
				"6C0C75598D65CE7D"
			]
			description: [
				"The &eElectrolytic Separator&r splits water into Hydrogen and Oxygen - the gases that unlock advanced processing."
				""
				"&e&lThis one block is why Mekanism goes further than every other tech mod here.&r Up to now everything has been items in, items out. From here Mekanism runs on &lgases&r, and gases are what take you from 2x ore to 5x."
				""
				"&e&lWhat each output is for:&r"
				"&7- &fOxygen&7 - feeds the &fPurification Chamber&7 for &a3x&7 ore"
				"&7- &fHydrogen&7 - burns in gas generators, and combines with chlorine for the &a4x&7 chain"
				""
				"&e&lPlumbing it:&r water in via &7Mechanical Pipes&r or a fluid tank, gases out via &7Pressurised Tubes&r. Gases do not travel in item pipes or fluid pipes - they need their own tubing. Put a &7Chemical Tank&r on each output as a buffer, or the separator throttles itself the moment one side backs up."
				""
				"&c&lIt is power-hungry.&r This is usually the point where a hand-fed generator stops being enough and you need a real power plant. Powah's reactors exist for exactly this."
				""
				"&8Water is free and infinite - a single Aqueous Accumulator or an infinite water source keeps it fed forever."
			]
			icon: "mekanism:electrolytic_separator"
			id: "742152612BC35B66"
			rewards: [{
				id: "137D67BC9DCE58D2"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Hydrogen and oxygen, free"
			tasks: [{
				id: "42F9089E2E1E241F"
				item: "mekanism:electrolytic_separator"
				type: "item"
			}]
			title: "Split the Water"
			x: -7.0d
			y: -1.0d
		}
		{
			dependencies: ["742152612BC35B66"]
			description: [
				"The &ePurification Chamber&r uses Oxygen to turn ores into 3 clumps each - tripling. Ore processing tier 3."
				""
				"&e&lThe 3x chain in full - each step needs its own machine:&r"
				"&7Ore &8→&7 &fPurification Chamber&7 (+oxygen) &8→&7 3x &fClump&r"
				"&7Clump &8→&7 &fCrusher&7 &8→&7 &fDirty Dust&r"
				"&7Dirty Dust &8→&7 &fEnrichment Chamber&7 &8→&7 &fDust&r"
				"&7Dust &8→&7 &fEnergized Smelter&7 &8→&7 &aIngot&r"
				""
				"&c&lThat is four machines for one ore.&r This is the shape of every Mekanism tier above 2x - the ladder gets longer, not just richer. Build it as a physical line with pipes between each stage and feed it once at the top."
				""
				"&e&lDo not tear down your 2x setup.&r The Enrichment Chamber and Energized Smelter you already built are &lstages in this chain&r, not replaced by it. Everything you own gets reused."
				""
				"&7Automate this before you go further. Hand-carrying clumps between four machines is the most tedious thing in the pack, and Pipez or Mekanism's own Logistical Transporters solve it in ten minutes.&r"
			]
			icon: "mekanism:purification_chamber"
			id: "43FBE8C75E6299BE"
			rewards: [{
				id: "01A6D355894DD9C1"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Purification: 3x per ore"
			tasks: [{
				id: "12559982DDDDAA0D"
				item: "mekanism:purification_chamber"
				type: "item"
			}]
			title: "Triple Your Ores"
			x: -3.0d
			y: -1.5d
		}
		{
			dependencies: ["43FBE8C75E6299BE"]
			description: [
				"The Chemical Injection Chamber uses Hydrogen Chloride to shatter ores into 4 shards each - QUADRUPLING."
				""
				"This is the full ore-processing chain. Combined with a Chemical Dissolution setup you can go to x5, but x4 is where most players live."
			]
			icon: "mekanism:chemical_injection_chamber"
			id: "7ECDAF64265C939E"
			rewards: [{
				id: "053646AF782E4851"
				type: "xp"
				xp: 40
			}]
			subtitle: "&7Chemical Injection: 4x per ore"
			tasks: [{
				id: "06C60CA51A032F73"
