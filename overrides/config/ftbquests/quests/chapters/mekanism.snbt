				type: "item"
			}]
			title: "Quadruple Your Ores"
			x: -1.0d
			y: -1.5d
		}
		{
			dependencies: [
				"6C0C75598D65CE7D"
			]
			icon: "mekanism:advanced_control_circuit"
			id: "267D2B1D2D8750CC"
			rewards: [{
				id: "2B40E7C3D6713C52"
