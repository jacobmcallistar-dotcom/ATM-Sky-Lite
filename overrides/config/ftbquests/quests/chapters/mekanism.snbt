				xp: 40
			}]
			subtitle: "&7Now with infused alloy"
			tasks: [{
				id: "6F4EFDE19179F43A"
				item: "mekanism:advanced_control_circuit"
				type: "item"
			}]
			title: "Advanced Circuits"
			x: -1.0d
			y: 1.5d
		}
		{
			dependencies: ["267D2B1D2D8750CC"]
			description: [
				"&eElite&r and &eUltimate Control Circuits&r are the top of the ladder - required for the best factories, the Digital Miner, and endgame gear."
				""
				"&e&lThe alloys behind them are the real cost:&r"
				"&7- &fElite&7 needs &fReinforced Alloy&7 - enriched alloy + infused diamond"
				"&7- &fUltimate&7 needs &fAtomic Alloy&7 - reinforced alloy + infused refined obsidian"
				""
				"&e&lRefined Obsidian is the wall.&r It comes from obsidian dust through the Osmium Compressor, and obsidian in a void world means lava plus water on repeat. Set up a dedicated obsidian generator before you start this tier or you will grind it a bucket at a time."
				""
				"&7Mystical Agriculture is the shortcut. Diamond and obsidian seeds turn this whole bottleneck into a farm you harvest - which is exactly why the Essence Farming chapter is marked recommended.&r"
				""
				"&e&lWhat these unlock:&r Ultimate Factories, the Quantum Entangloporter, the MekaSuit, and the fission and fusion lines that Act IV is built on. Everything expensive in Mekanism sits behind these two items."
			]
			icon: "mekanism:elite_control_circuit"
			id: "398BE9895D2BED1B"
			rewards: [{
				id: "2CE33709C5BC8FB3"
				type: "xp"
				xp: 60
			}]
			subtitle: "&7The last two tiers"
			tasks: [
				{
					id: "14B6A732A897EAE8"
					item: "mekanism:elite_control_circuit"
					type: "item"
				}
				{
					id: "1A32AA02B6DF2AB7"
					item: "mekanism:ultimate_control_circuit"
					type: "item"
				}
			]
			title: "Elite & Ultimate Circuits"
			x: 1.0d
			y: 1.5d
		}
		{
			dependencies: [
				"267D2B1D2D8750CC"
			]
			description: [
				"A Factory does the job of one machine, but on many items at once, in parallel."
				""
				"Build a Basic Smelting Factory to start automating - then upgrade the tier as your circuits allow."
			]
			icon: "mekanism:basic_smelting_factory"
			id: "5251868CACAB6B09"
			rewards: [{
				id: "40D8CB38E1C01438"
				type: "xp"
				xp: 40
			}]
			subtitle: "&7One machine, many slots"
			tasks: [{
				id: "43CDFE8B81B1E7F5"
				item: "mekanism:basic_smelting_factory"
				type: "item"
			}]
			title: "Automate It: Factories"
			x: -1.0d
			y: 3.0d
		}
		{
			dependencies: [
				"5251868CACAB6B09"
				"398BE9895D2BED1B"
			]
			description: [
				"Push factories to the top: Elite and Ultimate tiers process a dozen items at once. This is real industry."
				""
				"&e&lWhat a Factory actually is:&r a single machine with many parallel input slots instead of one. A Basic Factory has 3, Advanced 5, Elite 7, Ultimate 9. Each slot runs its own recipe simultaneously, so one Ultimate Smelting Factory replaces nine Energized Smelters and takes one block of space and one cable."
				""
				"&e&lThey come in types, set at craft time&r - Smelting, Enriching, Crushing, Compressing, Purifying, Injecting and more. Pick the type by what your ore line needs most; you cannot change it afterwards without recrafting."
				""
				"&e&lUpgrade in place.&r A Basic Factory plus the right tier installer becomes Advanced, then Elite, then Ultimate - you keep the machine and its contents. Do not scrap the old one."
				""
				"&c&lPower draw scales with the slots you actually use.&r An Ultimate Factory running one item costs almost nothing; running all nine at speed will eat a reactor. Watch your grid when you first fill one."
				""
				"&7This is the moment your base stops looking like a machine museum and starts looking like a factory - one block per processing step instead of nine.&r"
			]
			icon: "mekanism:elite_smelting_factory"
			id: "3D923C56F219EB9E"
			rewards: [
				{
					id: "44815BA9F91DE639"
					type: "xp"
					xp: 60
				}
				{
					id: "00509CAAE7DE3BAB"
					type: "random"
				}
			]
			subtitle: "&7Elite and Ultimate factories"
			tasks: [
				{
					id: "76F6C288AAEE4B34"
					item: "mekanism:elite_smelting_factory"
					type: "item"
				}
				{
					id: "16DD66FE825D83F9"
					item: "mekanism:ultimate_crushing_factory"
					type: "item"
				}
			]
			title: "Mass Production"
			x: 1.0d
			y: 3.0d
		}
		{
			dependencies: ["398BE9895D2BED1B"]
			description: [
				"The &eDigital Miner&r mines whole areas by filter, remotely. On a skyblock it's mostly for pulling from Mekanism's own ore-gen, but it's a rite of passage."
				""
				"&e&lHow it works:&r set a radius and a Y range, add &lfilters&r for the blocks you want, and it teleports matching blocks straight into its inventory from anywhere in range. It does not need a tunnel, a path, or line of sight - it simply removes them."
				""
				"&e&lFilter types worth knowing:&r"
				"&7- &fItem filter&7 - a specific block"
				"&7- &fTag filter&7 - everything matching a tag, e.g. all ores at once"
				"&7- &fMaterial filter&7 - everything made of a given material"
				""
				"&e&lThe two settings people miss:&r &7Inverse mode&r mines everything &lexcept&r your filters - the fastest way to clear a build area. And &7Silk Touch&r mode, which costs far more power but is the only way to pull certain blocks intact."
				""
				"&c&lIt is genuinely expensive to run&r and gets more so with radius. Start small."
				""
				"&8On a void island the honest use is clearing terrain in other dimensions - the Twilight Forest and the planets have real ore, and this is how you strip-mine them without swinging a pickaxe."
			]
			icon: "mekanism:digital_miner"
			id: "6E9FFB8BA9EFA7A6"
			rewards: [{
				id: "18252BA850EF783A"
				type: "xp"
				xp: 60
			}]
			subtitle: "&7Filtered mining at range"
			tasks: [{
				id: "61F7DD161969BE9B"
				item: "mekanism:digital_miner"
				type: "item"
			}]
			title: "The Digital Miner"
			x: 3.0d
			y: 0.5d
		}
		{
			dependencies: ["19236F17F30F94C7"]
			description: [
				"The &eTeleporter&r moves you across the world (and dimensions) instantly. Link two and step through."
				""
				"&e&lThe build:&r a Teleporter block plus a &7Teleporter Frame&r arch around it - the frame is what you walk through. Give both ends the same &lfrequency&r, exactly like the Entangloporter, and step in."
				""
				"&e&lIt needs power at both ends&r, and the cost scales with distance and whether you are crossing dimensions. A cross-dimension jump is expensive; keep an Energy Cube next to each pad rather than relying on a thin cable."
				""
				"&7Teleporters move &lyou&r and anything you carry, including a full backpack. They do not move items on their own - that is the Entangloporter's job.&r"
				""
				"&e&lWhy this matters in a space pack:&r rockets are one-way trips that need fuel and a launch pad. Once you have a teleporter on the Moon, you never build a return rocket again."
				""
				"&8Frequencies are shared with your team. Name them by destination or you will end up somewhere surprising."
			]
			icon: "mekanism:teleporter"
			id: "003FCED61DD91731"
			rewards: [{
				id: "34ECB489AF609CF1"
				type: "xp"
				xp: 40
			}]
			subtitle: "&7Point to point, any distance"
			tasks: [{
				id: "5D8CAE0C9022C6D5"
				item: "mekanism:teleporter"
				type: "item"
			}]
			title: "Teleporter"
			x: -5.0d
			y: 3.0d
		}
		{
			dependencies: ["19236F17F30F94C7"]
			description: [
				"The Induction Matrix is a multiblock battery that stores absurd amounts of power - the buffer your fission reactor will need."
				""
				"Build the casing and at least one cell + provider."
			]
			icon: "mekanism:induction_casing"
			id: "2B928184B2E69250"
			rewards: [{
				id: "3E4C55513718AB1F"
				type: "xp"
				xp: 60
			}]
			subtitle: "&7Terabuffer for the whole base"
			tasks: [
				{
					id: "366E1D9C05994B40"
					item: "mekanism:induction_casing"
					type: "item"
				}
				{
					id: "54FEFF2A0B98FD67"
					item: "mekanism:basic_induction_cell"
					type: "item"
				}
			]
			title: "The Induction Matrix"
			x: -7.0d
			y: 3.5d
		}
		{
			dependencies: ["6E9FFB8BA9EFA7A6"]
			description: [
				"The &eQuantum Entangloporter&r is wireless item/fluid/gas/energy transfer across any distance and dimension. Endgame logistics."
				""
				"&e&lIt is the single most useful block Mekanism makes.&r Set two or more to the same &lfrequency&r and they behave as one shared inventory - anything put into one comes out of any other, instantly, with no cable, no chunk-loading between them, and no distance limit."
				""
				"&e&lIt carries all five transfer types at once:&r items, fluids, gases, energy and heat. One block replaces a pipe, a tank, a tube and a cable."
				""
				"&e&lHow to set it up:&r right-click, open the frequency tab, create a named frequency, then set every other Entangloporter to the same name. Set each one's sides to input or output with the config tab - a side left on 'none' does nothing, which is the usual reason a new one appears dead."
				""
				"&7Frequencies can be private or public. Keep them private on a shared server unless you want other people's machines feeding into yours.&r"
				""
				"&e&lWhy it matters here:&r your rockets go to five worlds. This is how the Moon base sends Desh home without you flying it back."
			]
			icon: "mekanism:quantum_entangloporter"
			id: "0FBFBB69863D68E7"
			rewards: [{
				id: "3AB286755B3DF9AC"
				type: "xp"
				xp: 80
			}]
			subtitle: "&7Instant item transport"
			tasks: [{
				id: "70C7BDFDF3908EC6"
				item: "mekanism:quantum_entangloporter"
				type: "item"
			}]
			title: "Quantum Logistics"
			x: 5.0d
			y: 0.5d
		}
