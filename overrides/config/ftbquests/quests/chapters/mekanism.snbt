		{
			dependencies: ["398BE9895D2BED1B"]
			description: ["&9Mekanism Additions&r - the official 4th module, sibling to Generators and Tools. Misc content that used to live in core Mekanism: extra plastic building sets, a walkie talkie for cross-base comms, and Obsidian TNT for when regular TNT isn't enough."]
			icon: "mekanismadditions:obsidian_tnt"
