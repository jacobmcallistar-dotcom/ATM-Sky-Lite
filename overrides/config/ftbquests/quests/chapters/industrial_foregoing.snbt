		{
			dependencies: ["0F16000000000001"]
			description: [
				"Industrial Foregoing machines are built on &eMachine Frames&r in four tiers - Pity, Simple, Advanced and Supreme."
				""
				"&e&lEach tier is crafted from the one below&r, so the ladder is cumulative and the later machines are genuinely expensive. Budget accordingly."
				""
				"&7Almost every machine in this chapter is a frame plus contents, so set up a frame production line before you start building specific machines.&r"
			]
			icon: "industrialforegoing:machine_frame_pity"
			id: "236994F358186A1D"
