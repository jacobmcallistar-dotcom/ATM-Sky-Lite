				}
			]
			title: "&2Mob Duplicator & Slaughter Factory"
			x: 0.0d
			y: 1.5d
		}
		{
			description: [
				"A &eBlack Hole Unit&r stores an enormous quantity of a single item; a &eBlack Hole Tank&r does the same for one fluid."
				""
				"&e&lThey are the right answer for bulk.&r Cobblestone, dust, ore chunks and sludge belong in these rather than in AE2 cells - and a Black Hole Controller exposes a wall of them to your storage network as one inventory."
				""
				"&7They keep contents when broken, so they double as portable bulk transport.&r"
				""
				"&8Pair with an AE2 storage bus on the Black Hole Controller and your network sees everything without spending a single cell type."
			]
			icon: "industrialforegoing:black_hole_unit"
			id: "2A8DD64A999C6C0C"
			rewards: [{
				id: "6C413D71FA5B1461"
