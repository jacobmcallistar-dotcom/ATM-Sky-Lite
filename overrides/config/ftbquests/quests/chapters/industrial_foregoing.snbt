		}
		{
			description: [
				"The &eEnchantment Extractor&r pulls enchantments off items into books; the &eApplicator&r puts them back onto something else."
				""
				"&e&lThis is an enchantment laundry.&r Feed it enchanted junk from a mob farm or fishing, strip the enchantments to books, and apply the ones you want to your real gear."
				""
				"&7It runs on Essence, which your mob farm already produces. The whole chain - kill, extract, apply - automates.&r"
				""
				"&8Far more reliable than an enchanting table, and it needs no bookshelves or lapis."
			]
			icon: "industrialforegoing:enchantment_applicator"
			id: "5E562E699E7D750C"
			rewards: [{
				id: "65E6C19A9FFB3067"
