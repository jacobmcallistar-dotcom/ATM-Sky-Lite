	quests: [
		{
			description: [
				"&b&lSide Quest · Industrial Foregoing.&r"
				""
				"The heavy-industry branch. Where Mekanism is chemistry and AE2 is logistics, this is &obrute-force machines&r: laser drills that punch ore out of nothing, mob crushers, and storage that holds two billion of one item in a single block."
				""
				"The whole mod is built on one climbing part - the &eMachine Frame&r - and one weird resource, &ePink Slime&r. Everything here starts there."
				""
				"&7Optional. But the Ore Laser Base is one of the only ways in the pack to automate raw ore without a bee or a seed.&r"
			]
			icon: "industrialforegoing:laser_drill"
			id: "0F16000000000001"
			rewards: [{
				id: "0F16000000000101"
				type: "xp_levels"
				xp_levels: 3
			}]
			shape: "hexagon"
			size: 1.5d
			subtitle: "&7Brute-force automation"
			tasks: [{
				id: "0F16000000000201"
				title: "Read: The Industry Branch"
				type: "checkmark"
			}]
			title: "&bIndustrial Foregoing"
			x: -8.0d
			y: 0.0d
		}
		{
			description: [
				"Everything here is made of &ePlastic&r. Plastic comes from &eDry Rubber&r, which comes from &eLatex&r, which the &eLatex Processing Unit&r pulls from logs and water."
				""
				"Not glamorous. But no plastic, no machines - so make a stack and keep making it."
			]
			icon: "industrialforegoing:plastic"
