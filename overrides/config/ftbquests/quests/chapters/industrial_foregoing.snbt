			]
			title: "&2Black Hole Units & Tanks"
			x: 2.0d
			y: 1.5d
		}
		{
			description: [
				"The &eBiofuel Generator&r burns biofuel made from crops; the &eProtein Generator&r burns protein made from meat and mob drops."
				""
				"&e&lBoth close a loop you already have open.&r Your Plant Gatherer produces surplus crops; your Mob Slaughter Factory produces surplus meat. Feed them here and the farms part-fund their own power."
				""
				"&7The Petrified Fuel Generator is the odd one - it burns solid fuel but gets more efficient the longer it runs uninterrupted, so it rewards a steady supply.&r"
			]
			icon: "industrialforegoing:biofuel_generator"
			id: "1E1C2562E86DC963"
			rewards: [{
