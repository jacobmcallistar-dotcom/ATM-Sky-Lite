		}
		{
			dependencies: ["0F16000000000003"]
			description: [
				"Machines climb through frame tiers. Upgrade the &ePity&r frame into a &eSimple&r one, and the Simple into an &eAdvanced&r one - each unlocks better machines and higher speeds."
				""
				"Build one of each now so nothing downstream stops you."
			]
