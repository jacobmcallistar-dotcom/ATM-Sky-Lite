			]
			title: "&bThe Garden Cloche"
			x: -6.0d
			y: 3.0d
		}
		{
			dependencies: ["7E20000000000011"]
			description: [
				"The &eIndustrial Squeezer&r presses seeds into &ePlant Oil&r - 120 mB per hemp seed."
				""
				"It is a multiblock: craft the item, place it, and hit it with the Engineer's Hammer to form the structure. Feed it seeds from the cloche on a conveyor and it will run unattended forever."
				""
				"&7It also squeezes other things - check JEI. But hemp seeds are why it is here."
			]
			icon: "immersiveengineering:squeezer"
			id: "7E20000000000012"
			rewards: [{
				id: "7E20000000000512"
				type: "xp"
				xp: 50
