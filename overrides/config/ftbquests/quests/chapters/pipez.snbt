		{
			dependencies: ["2101000000000004"]
			description: [
				"&f&lSide Quest · Pipe Dreams.&r"
				""
				"Hoppers are slow, chest-to-chest by hand is worse, and the sieve never stops. Sooner or later every base needs things to move themselves."
				""
				"&ePipez&r is the cheap answer: one pipe block per resource - &eitems&r, &efluids&r, &eenergy&r, &egas&r - all configured with one tool, all upgradeable from iron to netherite. No network, no controller, no channels. Just pipes that work."
			]
			icon: "pipez:item_pipe"
			id: "7E10000000000001"
			rewards: [
				{
					count: 8
					id: "7E10000000000101"
					item: "minecraft:redstone"
					type: "item"
				}
				{
