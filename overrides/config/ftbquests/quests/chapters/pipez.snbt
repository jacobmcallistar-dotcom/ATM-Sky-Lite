					type: "xp"
					xp: 20
				}
			]
			shape: "hexagon"
			size: 1.5d
			subtitle: "&7Let the base do the walking"
			tasks: [{
				id: "7E10000000000201"
				title: "Stop carrying things by hand"
				type: "checkmark"
			}]
			title: "&bPipe Dreams"
			x: -8.0d
			y: 0.0d
		}
		{
			dependencies: ["7E10000000000001"]
			description: [
				"Two &eflint&r and two &esticks&r. That's the whole cost of every pipe decision you'll ever make."
				""
				"Right-click any pipe with the &eWrench&r to open that side's configuration: whether it &lextracts&r or just carries, what it filters, how it splits between targets (round robin, nearest, furthest, random) and how redstone controls it."
				""
				"A pipe with no wrench work does nothing. Keep it on your belt."
			]
			icon: "pipez:wrench"
			id: "7E10000000000002"
			rewards: [{
				id: "7E10000000000103"
				type: "xp"
				xp: 20
