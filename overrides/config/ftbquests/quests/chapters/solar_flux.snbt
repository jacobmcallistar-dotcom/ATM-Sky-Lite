		}
		{
			dependencies: ["7D00000000000003"]
			description: [
				"Every panel has upgrade slots, and this is what separates Solar Flux from ordinary solar panels."
				""
				"&e&lThe ones that matter:&r"
				"&7- &fEfficiency&7 - more FE per tick"
				"&7- &fCapacity&7 - bigger internal buffer, so a panel carries further into the night"
				"&7- &fTransfer Rate&7 - pushes power out faster"
				"&7- &fLow Light&7 - keeps producing in rain and at dusk"
				"&7- &fTraversal&7 - the panel pushes power to machines through blocks, no cable needed"
				"&7- &fDispersive&7 - charges items in nearby players' inventories"
				"&7- &fBlock Charging&7 - charges adjacent machines directly"
				""
				"&e&lTraversal plus Dispersive is the combination worth building for&r - a roof of panels that silently keeps your whole base and your gear charged with no wiring at all."
			]
			icon: "solarflux:efficiency_upgrade"
			id: "7D00000000000004"
