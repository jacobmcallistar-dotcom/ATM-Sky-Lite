		{
			dependencies: ["19236F17F30F94C7"]
			description: [
				"The Induction Matrix is a multiblock battery that stores absurd amounts of power - the buffer your fission reactor will need."
				""
				"Build the casing and at least one cell + provider."
			]
			icon: "mekanism:induction_casing"
