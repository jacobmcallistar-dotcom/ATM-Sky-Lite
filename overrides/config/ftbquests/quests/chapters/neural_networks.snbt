				type: "item"
			}]
			title: "&bBlank Data Models"
			x: -6.0d
			y: 1.5d
		}
		{
			dependencies: ["2103000000000009"]
			description: [
				"A &ePrediction Matrix&r is the blank that the Simulation Chamber fills. Feed matrices in, get mob-specific &7Predictions&r out."
				""
				"&e&lThis is the consumable that makes the whole loop run&r, and it is the thing you will always be short of. Automate matrix production before you scale up simulation, or your chambers idle waiting on input."
				""
				"&7The chamber consumes one matrix per simulation and returns a Prediction of the model's mob. Higher model tiers mean a better chance of a filled prediction rather than a wasted matrix.&r"
				""
				"&8Pipe matrices in and predictions out with any item transport - Mekanism transporters, Pipez, AE2 buses. This is a factory, not a hand-crank."
			]
			icon: "hostilenetworks:prediction_matrix"
			id: "7C00000000000004"
			rewards: [{
				id: "7C01000000000004"
				type: "xp"
				xp: 30
