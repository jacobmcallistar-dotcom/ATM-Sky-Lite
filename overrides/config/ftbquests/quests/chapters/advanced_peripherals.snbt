			y: 1.5d
		}
		{
			description: [
				"A &eBlock Reader&r returns the full NBT of the block in front of it; &eNBT Storage&r gives a computer persistent storage that survives restarts."
				""
				"&e&lThe Block Reader is how a computer inspects anything&r that has no dedicated peripheral - a Draconic reactor's stats, a machine's progress, a sign's text."
				""
				"&7NBT Storage matters because computer state is otherwise lost on chunk unload. Anything that needs to remember - a queue, a counter, a config - goes here.&r"
			]
			icon: "advancedperipherals:block_reader"
			id: "3837B07CDC7CAFFF"
			rewards: [{
				id: "67D70666C570EAC5"
				type: "xp"
				xp: 30
			}]
			subtitle: "&7Let a computer see the world"
			tasks: [
				{
					id: "1A4D7A1FA7EAEF73"
