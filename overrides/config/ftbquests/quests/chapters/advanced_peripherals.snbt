				type: "item"
			}]
			title: "&bChat Box"
			x: -2.0d
			y: -1.5d
		}
		{
			description: ["The &eEnergy Detector&r and &eEnvironment Detector&r let a computer read your FE buffers and world conditions - the sensor layer for any automation script."]
			icon: "advancedperipherals:energy_detector"
			id: "3610AD37D6DCD7C4"
