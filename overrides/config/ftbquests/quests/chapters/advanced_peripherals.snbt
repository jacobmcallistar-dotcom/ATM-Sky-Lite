			]
			title: "&bBlock Reader & NBT Storage"
			x: -2.0d
			y: 1.5d
		}
		{
			description: [
				"The &eInventory Manager&r reads and writes a player's inventory directly - given they are wearing a bound Memory Card."
				""
				"&e&lThis is the block that makes auto-equip scripts possible.&r Refill your hotbar from the ME network on a keypress, swap tool sets by location, drop a full backpack into storage automatically."
				""
				"&7It also reads armour and offhand, so a script can warn you before you launch a rocket without a full space suit.&r"
			]
			icon: "advancedperipherals:inventory_manager"
			id: "54DF490988C28146"
			rewards: [{
				id: "0296B48C76D162E6"
