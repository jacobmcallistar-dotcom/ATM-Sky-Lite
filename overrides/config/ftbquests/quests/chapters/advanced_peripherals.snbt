			x: 2.0d
			y: 1.5d
		}
		{
			description: [
				"The &eChat Box&r reads and writes in-game chat from Lua; the &eRedstone Integrator&r gives a computer redstone I/O on all six sides without touching the computer itself."
				""
				"&e&lThe Chat Box turns chat into a command line.&r A script that listens for '$stock iron' and replies with your ME count is twenty lines of Lua."
				""
				"&7The Redstone Integrator is placed anywhere in the world and controlled remotely over a wired modem, so one computer can switch redstone across your whole base.&r"
			]
			icon: "advancedperipherals:chat_box"
			id: "68920AB6DE93D2F2"
