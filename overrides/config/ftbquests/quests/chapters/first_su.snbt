		{
			dependencies: ["44EA000000000004"]
			description: [
				"The &eMechanical Press&r stamps ingots into &esheets&r - iron, gold, copper - the material half of Create is built from."
				""
				"Put a Depot under it, drop metal on, and thunk: industry."
			]
			icon: "create:mechanical_press"
