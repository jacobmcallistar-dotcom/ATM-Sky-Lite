		{
			dependencies: ["783ADB72710DB977"]
			description: [
				"MV runs on aluminium the way LV runs on steel."
				""
				"&7Bauxite from your blackstone sieve, washed and centrifuged, gives aluminium - and rutile and titanium as byproducts, which matter a great deal later.&r"
				""
				"&8Aluminium needs the Electric Blast Furnace to smelt. That is the next milestone and it is a big one.&r"
			]
			icon: "gtceu:aluminium_ingot"
			id: "702DDE04AD6FE445"
			rewards: [{
				id: "71298C2E8E2E3F3B"
