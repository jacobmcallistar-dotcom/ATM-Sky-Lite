			title: "&6HV Drilling and Gas Turbines"
			x: 9.0d
			y: -4.5d
		}
		{
			description: [
				"The component set again, in HV materials."
				""
				"&7By now you should have the entire component chain automated end to end - if you are still hand-crafting motors at HV, stop and fix that before going further.&r"
				""
				"&8Each tier's components need the tier's metal, its circuit and its cable. Three lines, all of which you already have.&r"
			]
			icon: "gtceu:hv_electric_motor"
