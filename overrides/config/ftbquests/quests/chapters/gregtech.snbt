			title: "&6Steam Multiblocks"
			x: -9.0d
			y: -2.0d
		}
		{
			description: [
				"A 3x3x3 of coke oven bricks. Turns coal into &eCoke&r and &eCreosote&r."
				""
				"&7Coke burns hotter and longer than coal, and it is what the Primitive Blast Furnace needs to make steel. Creosote is a fuel and a wood treatment.&r"
				""
				"&8Slow, cheap, and completely passive. Build two.&r"
			]
			icon: "gtceu:coke_oven"
			id: "3885F27EA6628C90"
			rewards: [{
				id: "1E1653DD4E593D6C"
