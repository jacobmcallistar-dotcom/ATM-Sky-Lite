		{
			description: [
				"Titanium components, EV circuits, EV cables."
				""
				"&7At this tier the assembler is doing nearly all the work and your job is keeping it supplied. If any part of the chain is still manual it will show here.&r"
			]
			icon: "gtceu:ev_machine_casing"
			id: "648499515FE6D868"
