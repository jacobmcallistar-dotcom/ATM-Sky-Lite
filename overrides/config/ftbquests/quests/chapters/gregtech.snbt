		{
			dependencies: ["3CF8A5492C9EB3DB"]
			description: [
				"Single-item storage that holds an absurd amount, and scales with tier."
				""
				"&7A Super Chest holds one item type in enormous quantity. A Super Tank does the same for fluid. Both are cheap and both solve the 'where do I put four million cobblestone' problem.&r"
				""
				"&8They also work beautifully as AE2 storage bus targets.&r"
			]
			icon: "gtceu:lv_super_chest"
