			y: -4.0d
		}
		{
			dependencies: ["13C3AE5E4E227AE3"]
			description: [
				"Two multiblocks that process eight things at once instead of one."
				""
				"&e&lSteam Grinder&r - a parallel macerator. &e&lSteam Oven&r - a parallel furnace."
				""
				"&7Both are bronze-tier and both massively outperform their single-block versions. If the steam age feels slow, this is the answer.&r"
				""
				"&8Check the structure preview in JEI. GregTech multiblocks are exact - one wrong block and the controller will not form.&r"
			]
			icon: "gtceu:steam_grinder"
