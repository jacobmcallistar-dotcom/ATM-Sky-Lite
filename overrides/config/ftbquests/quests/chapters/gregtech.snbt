			x: 3.0d
			y: 2.5d
		}
		{
			dependencies: ["664F33D2C27AF763"]
			description: [
				"&6&lA sealed, filtered room - and above HV, circuits will not assemble outside one.&r"
				""
				"Build a hollow box of &ePlascrete&r with a &eFilter Casing&r ceiling and the Cleanroom controller in a wall. Power it, seal it completely, and it maintains a cleanliness value."
				""
				"&c&lEvery opening breaks it.&r Doors must be airtight, cables and pipes must pass through the proper casings, and one missing block drops cleanliness to zero and stops every machine inside."
				""
				"&7Put your circuit assembler line, laser engraver and autoclave inside it. That is the whole reason it exists.&r"
				""
				"&8This is the gate most players hit unprepared - they build the HV circuit line, wonder why nothing runs, and discover the cleanroom requirement afterwards. Now you will not.&r"
			]
			icon: "gtceu:cleanroom"
			id: "27BCBBA619216663"
			rewards: [
				{
					id: "379B71636C8B2696"
					type: "xp"
					xp: 90
