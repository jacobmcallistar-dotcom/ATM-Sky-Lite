			x: 7.5d
			y: 1.0d
		}
		{
			description: [
				"The &eGas Large Turbine&r burns refinery gas, methane or any combustible gas for serious HV output."
				""
				"&7Your distillation tower produces exactly the fuels it wants. Between this and the Large Combustion Engine, HV power is a solved problem.&r"
			]
			icon: "gtceu:gas_large_turbine"
			id: "536EF740E4903450"
