					type: "item"
				}
			]
			title: "&6Autoclave and Laser Engraver"
			x: -1.5d
			y: 2.0d
		}
		{
			dependencies: ["783ADB72710DB977"]
			description: [
				"&eElectromagnetic Separator&r pulls magnetic byproducts out of dust - this is where neodymium comes from."
				""
				"&ePolarizer&r magnetises rods into magnetic rods, which every motor needs. &eSifter&r sorts gem dusts into graded gems."
				""
				"&7The separator is the quiet one that matters: run your centrifuged iron dust through it and you get gold and neodymium for free.&r"
			]
			icon: "gtceu:lv_electromagnetic_separator"
			id: "56F55553D55C9129"
			rewards: [{
