		{
			description: [
				"Batteries store EU and slot into battery buffers, machines and tools."
				""
				"&7Sodium is the cheap tier, lithium is better, cadmium better still. A &eCharger&r refills them and any electric tool you own.&r"
				""
				"&e&lBattery Buffers are also how you set a machine's voltage&r - the buffer tier determines what comes out of it.&r"
			]
			icon: "gtceu:lv_lithium_battery"
			id: "48910BCC5E54FCEB"
			rewards: [{
				id: "1B5815FB2C23A860"
