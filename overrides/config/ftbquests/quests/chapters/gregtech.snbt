		{
			dependencies: ["35C0E27B8CC84BB1"]
			description: [
				"Iron, chrome, nickel and manganese, blended and blasted at 1700K."
				""
				"&7Chromite from your netherrack sieve gives chrome; garnierite and pentlandite give nickel. Cupronickel coils are just hot enough.&r"
				""
				"&8Stainless is the HV casing metal and the material of the Vacuum Freezer, which is what unlocks the tier above it.&r"
			]
			icon: "gtceu:stainless_steel_ingot"
