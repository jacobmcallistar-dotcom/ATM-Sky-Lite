				}
			]
			title: "&6Batteries and Charging"
			x: -4.5d
			y: 0.5d
		}
		{
			description: [
				"Free power, in very small amounts."
				""
				"&7An LV solar panel produces a trickle. They are not a serious power source and they are not meant to be - but they are excellent for keeping a battery buffer topped up or running a single low-draw machine.&r"
				""
				"&8Your Solar Flux array in Ways to Power is a far better answer to solar. Use an Energy Converter.&r"
			]
			icon: "gtceu:lv_solar_panel"
			id: "74B1B399F473482C"
