		}
		{
			dependencies: ["35C0E27B8CC84BB1"]
			description: [
				"&eMixer&r blends dusts and fluids. &eFluid Solidifier&r casts molten material into shapes with a mould. &eForming Press&r stamps parts out of plates."
				""
				"&7Unglamorous machines that turn up in a surprising number of recipe chains. The Fluid Solidifier in particular is how you cast anything you can melt.&r"
			]
			icon: "gtceu:lv_mixer"
			id: "0DB29A7A9B8DBA44"
			rewards: [{
