					type: "item"
				}
			]
			title: "&6From Steam to Electricity"
			x: -6.0d
			y: 2.0d
		}
		{
			description: [
				"The steam set again, electric this time - faster, quieter, and no boiler to keep watered."
				""
				"&7Electric machines also accept &eoverclocks&r: feed a machine a higher voltage than it needs and it runs faster for proportionally more power. This is the core optimisation of the whole mod.&r"
				""
				"&8Once these are running you can dismantle the steam age entirely, or keep the multiblocks for bulk work.&r"
			]
			icon: "gtceu:lv_macerator"
			id: "19243218E629BD4F"
			rewards: [{
				id: "0305E3176F035AED"
				type: "xp"
				xp: 60
			}]
			subtitle: "&7Electric, and overclockable"
			tasks: [
				{
					id: "158F87DFEB249C57"
					item: "gtceu:lv_macerator"
					type: "item"
				}
				{
					id: "5ECC4C351463685C"
					item: "gtceu:lv_electric_furnace"
					type: "item"
				}
				{
					id: "663774E9CAD00607"
					item: "gtceu:lv_alloy_smelter"
					type: "item"
