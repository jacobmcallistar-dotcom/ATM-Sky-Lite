		{
			dependencies: ["783ADB72710DB977"]
			description: [
				"&eChemical Bath&r washes crushed ore in a fluid rather than water - mercury or persulfate, which pull out far more byproduct."
				""
				"&7This is the upgrade to the Ore Washer and it roughly doubles your byproduct yield again. Cinnabar from the blackstone sieve gives you the mercury.&r"
				""
				"&8Also used for dyeing, and for a handful of chemistry steps later.&r"
			]
			icon: "gtceu:lv_chemical_bath"
