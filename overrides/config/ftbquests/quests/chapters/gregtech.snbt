		{
			dependencies: ["35C0E27B8CC84BB1"]
			description: [
				"&e&lEnergy Converters&r translate between FE and EU in both directions."
				""
				"&7Your Mekanism fission reactor, your Create generators and your Solar Flux array all produce FE. GregTech eats EU. A converter bridges them, at a loss you set by the conversion ratio.&r"
				""
				"&c&lMind the amperage.&r A 4-amp converter at LV moves four amps - exceed it and nothing flows. Match the converter to the load."
				""
				"&8This is the quest that stops GregTech being an island. Everything you built in Act II can now power it.&r"
			]
			icon: "gtceu:lv_4a_energy_converter"
			id: "19DD54DF2A7B8F50"
			rewards: [
				{
					id: "7E665FAB6D1EAB7D"
					type: "xp"
					xp: 60
				}
				{
					id: "0E562FA6035BDB0F"
