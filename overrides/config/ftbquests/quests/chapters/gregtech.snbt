		}
		{
			dependencies: ["33F1BBD37C4B8F86"]
			description: [
				"32768 EU/t. Naquadah alloy hulls and crystal processor assemblies."
				""
				"&7Everything at this tier is an assembly line recipe. There is no hand-crafting your way to LuV and there was never meant to be.&r"
				""
				"&8Beyond LuV lie ZPM and UV. They are in the mod, they are not in this chapter, and reaching them is entirely up to you.&r"
			]
			icon: "gtceu:luv_machine_hull"
			id: "583DA29C23636A64"
