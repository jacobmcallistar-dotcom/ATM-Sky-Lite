		{
			dependencies: [
				"13C3AE5E4E227AE3"
				"0281B22E7C755283"
			]
			description: [
				"The same machines again, in steel, running at double speed on high-pressure steam."
				""
				"&7A straight upgrade. Worth doing once you have steel, and not before.&r"
				""
				"&8If you are already moving toward LV power you can skip this entirely - electric machines outclass both steam tiers.&r"
			]
